# Copy this file to .env and fill in real values locally. .env is gitignored;
# never commit real secrets. See docs/environment_configuration.md for details
# on each variable.

# SQLAlchemy connection string. Defaults to a local SQLite file if unset.
# Examples:
#   sqlite:///data/premiership.db
#   postgresql://user:password@localhost:5432/premiership
DATABASE_URL=sqlite:///data/premiership.db

# API key for the optional third-party football data API source.
# Leave blank to disable that ingestion source.
FOOTBALL_API_KEY=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Custom User-Agent sent with outbound HTTP requests during ingestion,
# so source sites can identify the requester.
INGESTION_USER_AGENT=scottish-premiership-dashboard/0.1 (contact: your-email@example.com)
